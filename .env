    │   │   │   ├── A.entity.ts      
    │   │   │   ├── B.entity.ts       
│   │  
src/infrastructure
│   ├── infrastructure/          
│   │   ├── repositories/
│   │   │   ├── UserRepository.ts  # Implements user-related API calls
│   │   │   ├── AuthRepository.ts  # Implements authentication API calls
│   │   ├── base/                  # Base classes for reusable logic
│   │   │   ├── BaseRepository.ts   # Generic repository pattern
│   │   │   ├── AuthService.ts      # Authentication service
│   │   ├── http/                   # API client (fetch, axios)
│   │   │   ├── HttpClient.ts
│   │
src/presentation
│   ├── presentation/               # UI layer (components, pages, hooks, and UI elements)
│   │   ├── components/              # Feature-specific UI components
│   │   │   ├── ADetailPage.tsx
│   │   │   ├── BDetailPage.tsx
│   │   ├── pages/                   # Page-level UI components
│   │   │   ├── APage.tsx
│   │   │   ├── BPage.tsx
│   │   ├── hooks/                   # Custom hooks for fetching/managing state
│   │   │   ├── useA.ts
│   │   │   ├── useB.ts
│   │   ├── ui/                      # Reusable UI components
│   │   │   ├── UserCard.tsx
│   │   │   ├── PostList.tsx 
src/  
│   ├── styles/                       # Global styles (Tailwind)
│   ├── Private routes/                       
│   │   ├── A.tsx
│   ├── App.tsx                        # Root React Component
│   ├── main.tsx                       # Entry point
│── public/                             # Static assets
